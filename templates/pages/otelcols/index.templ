package otelcols

import "github.com/thisisibrahimd/telesto/templates/layouts"

type OtelcolsViewModel struct {
	Otelcols []*OtelcolModel
}

templ Index(model OtelcolsViewModel) {
	@layouts.Main("Telesto | Otelcols") {
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold text-gray-900">Your Otelcols</h2>
			<a href="/otelcols/new" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors">
				+ Create New
			</a>
		</div>
		<div class="bg-white rounded-lg shadow overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
						<th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200">
					for _, o := range model.Otelcols {
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-6 py-4 text-sm font-mono text-gray-500">{ o.Id }</td>
							<td class="px-6 py-4 text-sm font-medium text-gray-900">{ o.Name }</td>
							<td class="px-6 py-4 text-right space-x-3">
								<a href={ "/otelcols/" + o.Id } class="text-sm text-indigo-600 hover:text-indigo-900">View</a>
								<a href={ "/otelcols/edit/" + o.Id } class="text-sm text-gray-600 hover:text-gray-900">Edit</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
