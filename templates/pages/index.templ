package pages

import "github.com/thisisibrahimd/telesto/templates/layouts"

templ Index() {
	@layouts.Main("Telesto") {
		<div class="text-center py-16">
			<h1 class="text-4xl font-bold text-gray-900">Welcome to Telesto</h1>
			<p class="mt-4 text-lg text-gray-500">Manage your OpenTelemetry collectors</p>
			<div class="mt-8">
				<a href="/otelcols" class="inline-flex items-center px-6 py-3 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors">
					View Otelcols
				</a>
			</div>
		</div>
	}
}
