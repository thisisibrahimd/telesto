package tokens

import "github.com/thisisibrahimd/telesto/templates/layouts"

templ Edit(token TokenModel) {
	@layouts.Console("Telesto | Tokens | Edit") {
		<div class="mb-6">
			<a href="/tokens" class="text-sm text-indigo-600 hover:text-indigo-900">&larr; Back to Tokens</a>
		</div>
		<div class="max-w-lg bg-white rounded-lg shadow p-6">
			<h2 class="text-2xl font-bold text-gray-900 mb-6">Edit Token</h2>
			<form hx-put={ "/tokens/edit/" + token.ID } hx-target="body" class="space-y-4">
				@Form(TokenFormModel{
					Name:        token.Name,
					TelestoID:   token.TelestoID,
					TelestoName: token.Telesto.Name,
					IsNew:       false,
				})
				<button type="submit" class="w-full px-4 py-2.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
					Save
				</button>
			</form>
		</div>
	}
}
