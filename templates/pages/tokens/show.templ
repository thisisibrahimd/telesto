package tokens

import "github.com/thisisibrahimd/telesto/templates/layouts"

templ Show(token TokenModel) {
	@layouts.Console("Telesto | Token") {
		<div class="mb-6">
			<a href="/tokens" class="text-sm text-indigo-600 hover:text-indigo-900">&larr; Back to Tokens</a>
		</div>
		<div class="bg-white rounded-lg shadow p-6">
			<h2 class="text-2xl font-bold text-gray-900 mb-6">Token Details</h2>
			<dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<dt class="text-sm font-medium text-gray-500">ID</dt>
					<dd class="mt-1 text-sm font-mono text-gray-900">{ token.ID }</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-gray-500">Name</dt>
					<dd class="mt-1 text-sm text-gray-900">{ token.Name }</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-gray-500">Telesto</dt>
					<dd class="mt-1 text-sm text-gray-900">
					{ token.TelestoID } -
					if token.Telesto != nil {
						<a href={ "/telestos/" + token.Telesto.ID } class="hover:text-indigo-600 transition-colors">{ token.Telesto.Name }</a>
					} else {
						<span class="text-gray-500">Unknown</span>
					}
				</dd>
				</div>
			</dl>
			if !token.Seen {
				<div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
					<p class="text-sm font-medium text-yellow-800">Copy this token now. You will not see it again.</p>
				</div>
				<div class="mt-4 flex items-center gap-2">
					<input type="text" id="token-secret" readonly value={ token.Token } class="flex-1 block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono bg-gray-50"/>
					<button type="button" class="inline-flex items-center px-4 py-2.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors" onclick="navigator.clipboard.writeText(document.getElementById('token-secret').value); this.textContent = 'Copied'; setTimeout(() => this.textContent = 'Copy', 2000);">
						Copy
					</button>
				</div>
			} else {
				<div class="mt-6">
					<p class="text-sm text-gray-500 italic">Token value hidden for security.</p>
				</div>
			}
			<div class="mt-6 flex items-center gap-3">
				<a href={ "/tokens/edit/" + token.ID } class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors">Edit</a>
				<button class="inline-flex items-center px-4 py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">Delete</button>
			</div>
		</div>
	}
}
