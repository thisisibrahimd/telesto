package pages

import "github.com/ory/kratos-client-go/v26"
import "github.com/thisisibrahimd/telesto/templates/layouts"
import "github.com/thisisibrahimd/telesto/templates/components"

templ Login(form client.UiContainer) {
	@layouts.Auth("Login") {
		<div>
			<h1 class="text-2xl font-bold text-gray-900 text-center">Sign in to Telesto</h1>
			@components.AuthForm(form)
		</div>
	}
}
