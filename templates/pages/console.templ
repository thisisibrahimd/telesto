package pages

import "github.com/thisisibrahimd/telesto/templates/layouts"

templ Console() {
	@layouts.Console("Console") {
		<div class="text-center py-16">
			<h1 class="text-4xl font-bold text-gray-900">Welcome to the Telesto Console</h1>
			<p class="mt-4 text-lg text-gray-500">Manage your Telestos, tokens, and billing.</p>
		</div>
	}
}
