package telestos

import "github.com/thisisibrahimd/telesto/templates/layouts"

templ Edit(telesto TelestoModel) {
	@layouts.Console("Telesto | Telestos | Edit") {
		<div class="mb-6">
			<a href="/telestos" class="text-sm text-indigo-600 hover:text-indigo-900">&larr; Back to Telestos</a>
		</div>
		<div class="max-w-lg bg-white rounded-lg shadow p-6">
			<h2 class="text-2xl font-bold text-gray-900 mb-6">Edit Telesto</h2>
			<form hx-put={ "/telestos/edit/" + telesto.ID } hx-target="body" class="space-y-4">
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
					<input type="text" id="name" name="name" placeholder="Name" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"/>
				</div>
				<button type="submit" class="w-full px-4 py-2.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
					Save
				</button>
			</form>
		</div>
	}
}
