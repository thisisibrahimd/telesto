package layouts

import "github.com/thisisibrahimd/telesto/templates/components"

templ Auth(title string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>{ title }</title>
			@components.Head()
		</head>
		<body class="flex items-center justify-center h-screen">
			<div class="bg-gray-100 rounded-3xl p-10">
					{ children... }
			</div>
		</body>
	</html>
}
