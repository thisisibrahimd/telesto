{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "required": [
        "username"
      ],
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "title": "Username",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 32,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              },
              "passkey": {
                "display_name": true
              }
            }
          }
        }
      }
    }
  }
}